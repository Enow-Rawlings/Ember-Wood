# =============================================================================
# EMBERWOOD — Environment Variable Reference
# Copy this file to .env.local and fill in your values for local development.
# NEVER commit .env.local or any file containing real secrets.
# Production secrets are set in Vercel / Render dashboards only.
# =============================================================================


# ─── Storefront (Vite public vars — safe to expose to browser) ────────────────
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# ─── Admin (Vite public vars — safe to expose to browser) ────────────────────
VITE_ADMIN_API_BASE_URL=http://localhost:4000/api/v1
VITE_ADMIN_SUPABASE_URL=https://your-project.supabase.co
VITE_ADMIN_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── API server (server-only — NEVER send to browser) ────────────────────────
PORT=4000
NODE_ENV=development

# Supabase — create a NEW Supabase project for Emberwood (separate from any other project)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # server only — never send to browser
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary — server-side signing (secret never reaches browser)
# Use a dedicated "emberwood" folder within your Cloudinary account
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret   # server only

# Email — Resend transactional email
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=orders@your-domain.com
EMAIL_SUPPORT=hello@your-domain.com

# AI content generation — Groq API (server-side only)
GROQ_API_KEY=your-groq-api-key

# Visitor alert email (receives new visitor notifications)
ALERT_EMAIL=your-email@example.com

# ─── Optional / future ────────────────────────────────────────────────────────

# Default locale and currency (ISO 4217 / BCP 47)
# DEFAULT_CURRENCY=GBP
# DEFAULT_LOCALE=en-GB

# Analytics (add after provider and consent confirmed)
# ANALYTICS_ID=

# ─── Notes ───────────────────────────────────────────────────────────────────
# - SUPABASE_SERVICE_ROLE_KEY must NEVER appear in browser code or Vite env vars
# - CLOUDINARY_API_SECRET must NEVER appear in browser code or Vite env vars
# - GROQ_API_KEY must NEVER appear in browser code or Vite env vars
# - The Supabase project for Emberwood must be separate from any other platform
# - Run database migrations against your Emberwood Supabase project only
